# EpicVibe Configuration

# Catalog path for sample data
EPICVIBE_CATALOG_PATH=fixtures/catalog/sample_catalog.json

# Inference provider: "fake" for testing or "anthropic" for production
EPICVIBE_INFERENCE_PROVIDER=fake

# Anthropic API key - REQUIRED when EPICVIBE_INFERENCE_PROVIDER=anthropic
EPICVIBE_ANTHROPIC_API_KEY=

# Anthropic model to use
EPICVIBE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Anthropic API base URL
EPICVIBE_ANTHROPIC_BASE_URL=https://api.anthropic.com

# JWT verification toggle
EPICVIBE_VERIFY_JWT=false

# JWKS URL for JWT verification
EPICVIBE_JWKS_URL=

# JWT audience claim
EPICVIBE_JWT_AUDIENCE=

# Audit database path
EPICVIBE_AUDIT_DB_PATH=audit.db

# Cache TTL in seconds
EPICVIBE_CACHE_TTL_SECONDS=3600

# --- Downtime (offline) ordering subsystem ---------------------------------
# Prefix EPICVIBE_DOWNTIME_ ; see src/epicvibe/downtime/config.py

# Extraction provider: "fake" (deterministic keyword/regex, no key) or "anthropic"
EPICVIBE_DOWNTIME_PROVIDER=fake

# Anthropic key for the downtime extractor. Falls back to ANTHROPIC_API_KEY
# or EPICVIBE_ANTHROPIC_API_KEY when blank.
EPICVIBE_DOWNTIME_ANTHROPIC_API_KEY=

# PHI gate. A downtime transcript is ambient clinical audio and contains the
# patient's name, DOB and chief complaint. EPICVIBE_DOWNTIME_PROVIDER=anthropic
# refuses to start unless this is true - leave it false to keep every transcript
# on the box (the "fake" provider is a local keyword/regex extractor).
EPICVIBE_DOWNTIME_ALLOW_PHI_TO_MODEL=false

# Model used for template selection and template filling
EPICVIBE_DOWNTIME_MODEL=claude-opus-5

# Offline order-template library and sample ambient transcripts
EPICVIBE_DOWNTIME_TEMPLATES_DIR=fixtures/downtime/templates
EPICVIBE_DOWNTIME_TRANSCRIPTS_DIR=fixtures/downtime/transcripts

# Durable captured-order store
EPICVIBE_DOWNTIME_DB_PATH=downtime.db

# HL7v2 MLLP integration engine (Epic Bridges / Rhapsody / Mirth)
EPICVIBE_DOWNTIME_ENGINE_HOST=127.0.0.1
EPICVIBE_DOWNTIME_ENGINE_PORT=2575

# HL7 MSH sending/receiving application and facility
EPICVIBE_DOWNTIME_SENDING_APPLICATION=EPICVIBE
EPICVIBE_DOWNTIME_SENDING_FACILITY=DOWNTIME
EPICVIBE_DOWNTIME_RECEIVING_APPLICATION=EPIC
EPICVIBE_DOWNTIME_RECEIVING_FACILITY=BRIDGES

# Capture UI bind address (read by python -m epicvibe.downtime)
EPICVIBE_DOWNTIME_HOST=127.0.0.1
EPICVIBE_DOWNTIME_PORT=8200
