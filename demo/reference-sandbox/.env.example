# Copy to .env if registry.npmjs.org is not reachable from inside Docker on your
# network (symptom: the cds-sandbox build fails with npm's
# "Exit handler never called!" after ERR_SSL_SSL/TLS_ALERT_HANDSHAKE_FAILURE).
# Use whatever `npm config get registry` reports on the host.
NPM_REGISTRY=https://registry.npmjs.org/
